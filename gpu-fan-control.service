[Unit]
Description=GPU Fan Control Service
After=systemd-modules-load.service

[Service]
Type=notify
User=root
EnvironmentFile=-/etc/default/gpu-fan-control
RuntimeDirectory=gpu-fan-control
RuntimeDirectoryMode=0755
ExecStartPre=/usr/local/bin/gpu-fan-control.py --set-safe-pwm
ExecStart=/usr/local/bin/gpu-fan-control.py
ExecStopPost=/usr/local/bin/gpu-fan-control.py --set-safe-pwm
Restart=on-failure
RestartSec=3
TimeoutStartSec=20
TimeoutStopSec=15
WatchdogSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/sys/class/hwmon /run/gpu-fan-control

[Install]
WantedBy=multi-user.target
