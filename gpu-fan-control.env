# Copy this file to /etc/default/gpu-fan-control and tune for the target host.
NZXT_HWMON_NAME=nzxtsmart2
NVIDIA_HWMON_NAME=nvidia
PWM_CHANNEL=1
FAN_CHANNEL=1
GPU_INDEX=0
# GPU_PCI_BUS_ID=00000000:01:00.0
MIN_TEMP=35
MAX_TEMP=75
CRITICAL_TEMP=82
MIN_PWM=18
MAX_PWM=200
SAFE_PWM=200
EMERGENCY_PWM=255
SLEEP_INTERVAL=5
TEMP_WINDOW=6
MAX_CONSECUTIVE_ERRORS=3
PWM_STEP=5
MIN_PWM_DELTA=5
MIN_RPM=700
RPM_CHECK_PWM=120
MAX_CONSECUTIVE_RPM_ERRORS=3
LOG_INTERVAL=12
